<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Zonas | EventoPe</title>
<%@ include file="/WEB-INF/views/common/bootstrap.jspf" %></head><body class="bg-light">
<%@ include file="/WEB-INF/views/common/navbar.jspf" %>
<main class="container pb-5"><div class="d-flex justify-content-between align-items-center mb-3"><h1 class="h3 mb-0">Zonas, precios y aforo</h1><a class="btn btn-outline-secondary" href="<c:url value='/admin/eventos'/>">Volver a eventos</a></div>
<%@ include file="/WEB-INF/views/common/alertas.jspf" %>
<p>Evento: <strong><c:out value="${evento.nombre}"/></strong> · Aforo: <c:out value="${evento.aforo}"/></p>
<div class="row g-4"><section class="col-lg-5"><div class="card card-body"><h2 class="h5">Agregar / editar zona</h2>
<form method="post" action="<c:url value='/admin/eventos/zonas'><c:param name='eventoId' value='${evento.id}'/></c:url>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="guardar"><input type="hidden" name="eventoId" value="${evento.id}"><input type="hidden" name="id" value="${zonaEditar.id}">
<c:set var="campoNombre" value="nombreZona"/><c:set var="campoEtiqueta" value="Nombre de zona"/><c:set var="campoTipo" value="text"/><c:set var="campoValor" value="${zonaEditar.nombreZona}"/><c:set var="campoMin" value=""/><c:set var="campoStep" value=""/><%@ include file="/WEB-INF/views/common/campo.jspf" %>
<c:set var="campoNombre" value="precioBase"/><c:set var="campoEtiqueta" value="Precio (S/)"/><c:set var="campoTipo" value="number"/><c:set var="campoValor" value="${zonaEditar.precioBase}"/><c:set var="campoMin" value="0"/><c:set var="campoStep" value="0.01"/><%@ include file="/WEB-INF/views/common/campo.jspf" %>
<c:set var="campoNombre" value="aforoTotal"/><c:set var="campoEtiqueta" value="Capacidad"/><c:set var="campoTipo" value="number"/><c:set var="campoValor" value="${zonaEditar.aforoTotal}"/><c:set var="campoMin" value="1"/><c:set var="campoStep" value="1"/><%@ include file="/WEB-INF/views/common/campo.jspf" %>
<button class="btn btn-primary" type="submit">Guardar zona</button></form></div></section>
<section class="col-lg-7"><div class="card card-body"><h2 class="h5">Zonas actuales</h2><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Zona</th><th>Precio</th><th>Disponibles</th><th>Capacidad</th><th></th></tr></thead><tbody><c:forEach var="zona" items="${zonas}"><tr><td><c:out value="${zona.nombreZona}"/></td><td>S/ <c:out value="${zona.precioBase}"/></td><td><c:out value="${zona.aforoDisponible}"/></td><td><c:out value="${zona.aforoTotal}"/></td><td class="d-flex gap-2"><a class="btn btn-sm btn-outline-primary" href="<c:url value='/admin/eventos/zonas'><c:param name='eventoId' value='${evento.id}'/><c:param name='editar' value='${zona.id}'/></c:url>">Editar</a><form method="post" action="<c:url value='/admin/eventos/zonas'><c:param name='eventoId' value='${evento.id}'/></c:url>"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="eliminar"><input type="hidden" name="eventoId" value="${evento.id}"><input type="hidden" name="id" value="${zona.id}"><button class="btn btn-sm btn-outline-danger" type="submit">Borrar</button></form></td></tr></c:forEach></tbody></table></div></div></section></div></main></body></html>

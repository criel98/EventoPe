<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<nav aria-label="Navegación principal" class="navegacion">
  <div style="display: flex; align-items: center; gap: 8px;">
    <a href="<c:url value='/eventos'/>" class="logo-brand" style="margin-right: 8px;">
      Evento<span style="color: #4f46e5;">Pe</span>
    </a>
  </div>

  <div class="navegacion-enlaces">
    <c:choose>
      <c:when test="${empty sessionScope.sesionUsuario}">
        <a href="<c:url value='/login'/>">Iniciar sesión</a>
        <a href="<c:url value='/registro'/>" style="background: #4f46e5; color: #ffffff;">Crear cuenta</a>
        <a href="<c:url value='/personal/login'/>" style="font-size: 0.85rem; color: #64748b;">Seguridad</a>
      </c:when>
      <c:otherwise>
        <span class="nombre-sesion"><c:out value="${sessionScope.sesionUsuario.nombre}"/></span>
        <c:if test="${sessionScope.sesionUsuario.tipo == 'CLIENTE'}">
          <a href="<c:url value='/cuenta/perfil'/>">Mi cuenta</a>
          <a href="<c:url value='/entradas'/>" style="background: #eef2ff; color: #4f46e5; font-weight: 700;">&#127915; Mis entradas</a>
        </c:if>
        <c:if test="${sessionScope.sesionUsuario.rol == 'VALIDACION'}">
          <a href="<c:url value='/seguridad/panel'/>" style="background: #ecfdf5; color: #065f46; font-weight: 700;">&#128269; Panel de validación</a>
        </c:if>
        <form method="post" action="<c:url value='/logout'/>" style="margin: 0;">
          <input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>">
          <button type="submit">Salir</button>
        </form>
      </c:otherwise>
    </c:choose>
  </div>
</nav>

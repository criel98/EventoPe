  ADMINISTRADOR_PLATAFORMA ||--o{ DISPOSITIVO_VALIDACION : "operador_id"
  EVENTO_CULTURAL ||--o{ DISPOSITIVO_VALIDACION : "evento_id"
  DISPOSITIVO_VALIDACION ||--o{ CONTROL_ACCESO_PUERTA : "dispositivo_id"
  ADMINISTRADOR_PLATAFORMA ||--o{ CONTROL_ACCESO_PUERTA : "operador_id"
  ADMINISTRADOR_PLATAFORMA |o--o{ CONTROL_ACCESO_PUERTA : "autorizado_por_id"
  ENTRADA_DIGITAL |o--o{ CONTROL_ACCESO_PUERTA : "entrada_id"
  CONTROL_ACCESO_PUERTA ||--o{ INCIDENCIA_ACCESO : "control_id"
  ADMINISTRADOR_PLATAFORMA |o--o{ INCIDENCIA_ACCESO : "resuelta_por_id"
  USUARIO_CLIENTE ||--o{ NOTIFICACION_USUARIO : "cliente_id"
  USUARIO_CLIENTE ||--o{ ENTRADA_DIGITAL : "comprador_id"

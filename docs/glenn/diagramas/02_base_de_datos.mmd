  DISPOSITIVO_VALIDACION {
    int id PK
    int operador_id FK
    int evento_id FK
    varchar nombre_puerta
    varchar modelo_celular
    char token_acceso_hash UK
    varchar estado_dispositivo "ACTIVO|REVOCADO"
  }
  CONTROL_ACCESO_PUERTA {
    int id PK
    char solicitud_id UK
    char solicitud_hash
    int evento_id FK
    int dispositivo_id FK
    int operador_id FK
    int entrada_id FK "nullable"
    datetime hora_ingreso
    varchar estado_acceso "PERMITIDO|DENEGADO"
    varchar motivo
    int autorizado_por_id FK "nullable"
  }
  INCIDENCIA_ACCESO {
    int id PK
    int control_id FK
    varchar tipo_incidencia
    text descripcion
    varchar severidad "ALTA|MEDIA|BAJA"
    varchar estado_resolucion "ABIERTA|RESUELTA|DESCARTADA"
    int resuelta_por_id FK "nullable"
    datetime fecha_resolucion "nullable"
    varchar motivo_resolucion "nullable"
  }
  NOTIFICACION_USUARIO {
    int id PK
    int cliente_id FK
    varchar titulo_mensaje "prefijo = tipo"
    text contenido
    datetime fecha_envio "UTC"
    boolean leido
  }
  HISTORIAL_ROTACION_QR {
    int id PK
    int qr_id FK
    bigint intervalo
    datetime hora_generacion
    char hash_anterior
    char hash_nuevo
  }
